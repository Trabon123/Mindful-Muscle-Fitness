---
/**
 * Mind ⇄ Muscle: a CSS-sticky stage (no GSAP pin, so it plays well with Lenis).
 * Scroll scrubs a MorphSVG timeline: brain → muscle fibre → barbell.
 * Reduced motion: the three drawings crossfade instead of morphing.
 * Without JS: all three beats render as a normal list.
 * Behaviour lives in src/scripts/motion.ts.
 */
import { morph } from '../data/sections';
import { shapes } from './morph-shapes';

const order = morph.beats.map((b) => b.shape);
---

<section id="method" class="morph relative" data-morph aria-labelledby="morph-title" data-active="0">
  <div class="stage-wrap">
    <div class="mx-auto grid h-full w-full max-w-[1800px] grid-rows-[auto_1fr_auto] px-5 pt-10 pb-24 md:px-10 md:py-14">
      <!-- Title row -->
      <header class="flex flex-wrap items-end justify-between gap-x-10 gap-y-3">
        <div>
          <p class="micro mb-3 text-sage-deep">{morph.eyebrow}</p>
          <h2 id="morph-title" class="leading-[0.9]">
            <span class="mind block text-[clamp(2.4rem,6vw,5.5rem)]">{morph.title.mind}</span>
            <span class="muscle block text-[clamp(2.6rem,6.6vw,6rem)]">{morph.title.muscle}</span>
          </h2>
          <p class="sr-only">{morph.srIntro}</p>
        </div>
        <!-- Progress: Mindset → Movement → Momentum -->
        <ol class="progress micro hidden items-center gap-3 text-[0.68rem] md:flex" aria-hidden="true">
          {morph.beats.map((b, i) => (
            <>
              {i > 0 && <li class="arrow">→</li>}
              <li class="tick" data-i={i}>{b.word}</li>
            </>
          ))}
        </ol>
      </header>

      <!-- Stage -->
      <div class="stage grid min-h-0 items-center gap-6 md:grid-cols-12 md:gap-10">
        <div class="art relative grid place-items-center md:col-span-7" aria-hidden="true">
          <div class="art-glow breathe" style="--b-min:.86;--b-max:1.08"></div>
          <svg class="art-svg" viewBox="0 0 400 300" fill="none">
            <!-- morph target (enhanced, full motion) -->
            <path id="morph-path" class="stroke" d={shapes[order[0]]} />
            <!-- crossfade layers (reduced motion) + morph sources -->
            {order.map((name, i) => (
              <path id={`shape-${name}`} class="stroke layer allow-fade" data-layer={i} d={shapes[name]} />
            ))}
          </svg>
        </div>

        <div class="beats relative md:col-span-5">
          {morph.beats.map((b, i) => (
            <article class="beat allow-fade" data-beat={i}>
              <p class="micro mb-4 flex items-center gap-3 text-ink/70">
                <span class="tabular-nums">0{i + 1}</span>
                <span class="h-px w-8 bg-[var(--hairline)]" />
                {b.offering}
              </p>
              <h3 class="beat-word muscle text-[clamp(3.4rem,7vw,7.25rem)]">
                {b.word}
              </h3>
              <p class="mt-5 max-w-[34ch] text-[1.05rem] leading-relaxed text-ink/75 md:text-[1.15rem]">{b.body}</p>
            </article>
          ))}
        </div>
      </div>

      <!-- Scroll hint -->
      <p class="hint micro mt-6 hidden text-[0.62rem] text-ink/70 md:block" aria-hidden="true">Keep scrolling · breathe in, breathe out</p>
    </div>
  </div>
</section>

<style>
  /* ── Static (no-JS) layout ─────────────────────────────── */
  .stage-wrap { position: relative; }
  .layer { display: none; }
  .beats { display: grid; gap: 3.5rem; }
  .art { aspect-ratio: 4 / 3; max-height: 60svh; width: 100%; }
  .art-svg {
    position: relative;
    width: min(100%, 680px);
    height: auto;
    overflow: visible;
  }
  .stroke {
    stroke: var(--color-ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .art-glow {
    position: absolute;
    width: 78%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--color-sage) 55%, transparent), transparent);
  }
  .tick { transition: color 1.2s var(--ease-breath); color: color-mix(in oklab, var(--color-ink) 45%, transparent); }
  .arrow { color: color-mix(in oklab, var(--color-ink) 30%, transparent); }

  /* ── Enhanced: sticky stage, one beat at a time ────────── */
  .morph.is-enhanced { height: 360svh; }
  .morph.is-enhanced .stage-wrap {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .morph.is-enhanced .beats { display: grid; gap: 0; }
  .morph.is-enhanced .beat {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(1.25rem);
    filter: blur(6px);
    transition:
      opacity 1.1s var(--ease-breath),
      transform 1.4s var(--ease-exhale),
      filter 1.1s var(--ease-breath);
    pointer-events: none;
  }
  .morph[data-active='0'] .beat[data-beat='0'],
  .morph[data-active='1'] .beat[data-beat='1'],
  .morph[data-active='2'] .beat[data-beat='2'] {
    opacity: 1;
    transform: none;
    filter: none;
    pointer-events: auto;
  }
  .morph[data-active='0'] .tick[data-i='0'],
  .morph[data-active='1'] .tick[data-i='1'],
  .morph[data-active='2'] .tick[data-i='2'] { color: var(--color-ink); }

  /* Reduced motion: crossfade the three drawings */
  .morph.is-crossfade #morph-path { display: none; }
  .morph.is-crossfade .layer {
    display: block;
    opacity: 0;
    transition: opacity 1.2s var(--ease-breath);
  }
  .morph.is-crossfade[data-active='0'] .layer[data-layer='0'],
  .morph.is-crossfade[data-active='1'] .layer[data-layer='1'],
  .morph.is-crossfade[data-active='2'] .layer[data-layer='2'] { opacity: 1; }

  @media (max-width: 767px) {
    .morph.is-enhanced .stage { grid-template-rows: minmax(0, 0.9fr) auto; align-content: center; }
    .morph.is-enhanced .art { max-height: 32svh; }
  }
</style>
