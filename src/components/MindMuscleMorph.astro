---
/**
 * Mind ⇄ Muscle: a normal-height section. Visitors step through the three
 * beats with the back / next buttons or by picking a step directly; the page
 * scrolls past freely. Each step morphs the line drawing (MorphSVG):
 * brain → muscle fibre → barbell.
 * Reduced motion: the drawings crossfade instead of morphing.
 * Without JS: all three beats render as a normal list.
 * Behaviour lives in src/scripts/motion.ts.
 */
import Icon from './Icon.astro';
import { morph } from '../data/sections';
import { shapes } from './morph-shapes';

const order = morph.beats.map((b) => b.shape);
const total = String(morph.beats.length).padStart(2, '0');
---

<section id="method" class="morph relative px-5 py-[14vh] md:px-10" data-morph aria-labelledby="morph-title" data-active="0">
  <div class="mx-auto w-full max-w-[1800px]">
    <!-- Title row -->
    <header class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
      <div>
        <p class="micro mb-3 text-sage-deep">{morph.eyebrow}</p>
        <h2 id="morph-title" class="leading-[0.9]">
          <span class="mind block text-[clamp(2.4rem,6vw,5.5rem)]">{morph.title.mind}</span>
          <span class="muscle block text-[clamp(2.6rem,6.6vw,6rem)]">{morph.title.muscle}</span>
        </h2>
        <p class="sr-only">{morph.srIntro}</p>
      </div>
      <!-- Steps: Mindset → Movement → Momentum (jump straight to one) -->
      <ol class="steps controls micro flex flex-wrap items-center gap-x-2 gap-y-2 text-[0.68rem]" aria-label="Steps">
        {morph.beats.map((b, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span class="arrow" aria-hidden="true">→</span>}
            <button type="button" class="step" data-go={i} aria-controls={`beat-${i}`} aria-current={i === 0 ? 'step' : undefined}>
              {b.word}
            </button>
          </li>
        ))}
      </ol>
    </header>

    <!-- Stage -->
    <div class="stage mt-10 grid items-center gap-8 md:mt-6 md:grid-cols-12 md:gap-10">
      <div class="art relative grid place-items-center md:col-span-7" aria-hidden="true">
        <div class="art-glow breathe" style="--b-min:.86;--b-max:1.08"></div>
        <svg class="art-svg" viewBox="0 0 400 300" fill="none">
          <!-- morph target (full motion) -->
          <path id="morph-path" class="stroke" d={shapes[order[0]]} />
          <!-- crossfade layers (reduced motion) + morph sources -->
          {order.map((name, i) => (
            <path id={`shape-${name}`} class="stroke layer allow-fade" data-layer={i} d={shapes[name]} />
          ))}
        </svg>
      </div>

      <div class="md:col-span-5">
        <div class="beats relative" aria-live="polite">
          {morph.beats.map((b, i) => (
            <article id={`beat-${i}`} class="beat allow-fade" data-beat={i}>
              <p class="micro mb-4 flex items-center gap-3 text-ink/70">
                <span class="tabular-nums">0{i + 1}</span>
                <span class="h-px w-8 bg-[var(--hairline)]" />
                {b.offering}
              </p>
              <h3 class="beat-word muscle text-[clamp(3.4rem,7vw,7.25rem)]">{b.word}</h3>
              <p class="mt-5 max-w-[34ch] text-[1.05rem] leading-relaxed text-ink/75 md:text-[1.15rem]">{b.body}</p>
            </article>
          ))}
        </div>

        <!-- Back / next -->
        <div class="controls mt-10 flex items-center gap-3">
          <button type="button" class="nav-btn" data-step="-1" aria-label="Previous step">
            <Icon name="arrow" size={18} class="rotate-180" />
          </button>
          <button type="button" class="nav-btn nav-next" data-step="1" aria-label="Next step">
            <Icon name="arrow" size={18} />
          </button>
          <span class="ml-3 h-px flex-1 bg-[var(--hairline)]" aria-hidden="true"></span>
          <span class="count micro text-[0.62rem] text-ink/70 tabular-nums" aria-hidden="true">01 / {total}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Static (no-JS) layout ─────────────────────────────── */
  .layer { display: none; }
  .beats { display: grid; gap: 3.5rem; }
  .controls { display: none; }
  .art { aspect-ratio: 4 / 3; max-height: 56svh; width: 100%; }
  .art-svg {
    position: relative;
    width: min(100%, 680px);
    height: auto;
    overflow: visible;
  }
  .stroke {
    stroke: var(--color-ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .art-glow {
    position: absolute;
    width: 78%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--color-sage) 55%, transparent), transparent);
  }

  /* ── Controls ─────────────────────────────────────────── */
  .step {
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border-radius: 999px;
    letter-spacing: inherit;
    text-transform: inherit;
    color: color-mix(in oklab, var(--color-ink) 70%, var(--color-bone));
    transition: color 0.9s var(--ease-breath), box-shadow 0.9s var(--ease-breath), background-color 0.9s var(--ease-breath);
  }
  .step:hover { color: var(--color-ink); box-shadow: inset 0 0 0 1px var(--hairline); }
  .step[aria-current='step'] {
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }
  .arrow { color: color-mix(in oklab, var(--color-ink) 35%, transparent); }
  .nav-btn {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-ink) 30%, transparent);
    transition: box-shadow 0.8s var(--ease-breath), background-color 0.8s var(--ease-breath), opacity 0.8s var(--ease-breath);
  }
  .nav-btn:hover:not(:disabled) { box-shadow: inset 0 0 0 1px var(--color-ink); background: var(--color-bone-dim); }
  .nav-next { background: var(--color-ink); color: var(--color-bone); box-shadow: none; }
  .nav-next:hover:not(:disabled) { background: var(--color-ink-soft); }
  .nav-btn:disabled { opacity: 0.35; cursor: default; }

  /* ── Enhanced: one beat at a time ─────────────────────── */
  .morph.is-enhanced .controls { display: flex; }
  .morph.is-enhanced .beats { gap: 0; }
  .morph.is-enhanced .beat {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(1.25rem);
    filter: blur(6px);
    transition:
      opacity 1.1s var(--ease-breath),
      transform 1.4s var(--ease-exhale),
      filter 1.1s var(--ease-breath);
    pointer-events: none;
  }
  .morph[data-active='0'] .beat[data-beat='0'],
  .morph[data-active='1'] .beat[data-beat='1'],
  .morph[data-active='2'] .beat[data-beat='2'] {
    opacity: 1;
    transform: none;
    filter: none;
    pointer-events: auto;
  }

  /* Reduced motion: crossfade the three drawings */
  .morph.is-crossfade #morph-path { display: none; }
  .morph.is-crossfade .layer {
    display: block;
    opacity: 0;
    transition: opacity 1.2s var(--ease-breath);
  }
  .morph.is-crossfade[data-active='0'] .layer[data-layer='0'],
  .morph.is-crossfade[data-active='1'] .layer[data-layer='1'],
  .morph.is-crossfade[data-active='2'] .layer[data-layer='2'] { opacity: 1; }

  @media (max-width: 767px) {
    .art { max-height: 34svh; }
  }
  /* Phones: three compact pills on one line, no arrows between them */
  @media (max-width: 639px) {
    .steps { gap: 0.4rem; flex-wrap: nowrap; }
    .steps li { gap: 0; }
    .arrow { display: none; }
    .step { padding: 0 0.7rem; min-height: 2.5rem; letter-spacing: 0.1em; }
  }
</style>
