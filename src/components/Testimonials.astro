---
/**
 * Slow drift carousel. A native horizontal scroller (works with touch and
 * trackpads), auto-drifting at reading pace via motion.ts. Pauses on hover,
 * focus, or the pause button. Prev/next buttons and arrow keys move by a card.
 */
import Icon from './Icon.astro';
import { testimonials } from '../data/testimonials';
import { testimonialsSection as t } from '../data/sections';

const star = 'M12 3.2l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6-4.5-4.2 6.1-.7Z';
---

<section id="reviews" class="reviews relative py-[16vh]" aria-labelledby="reviews-title" data-carousel>
  <div class="mx-auto mb-12 flex max-w-[1500px] flex-wrap items-end justify-between gap-8 px-5 md:px-10">
    <div>
      <p class="micro mb-5 text-sage-deep">{t.eyebrow}</p>
      <h2 id="reviews-title" class="leading-[0.9]">
        <span class="mind block text-[clamp(2.6rem,6vw,5.6rem)] text-sage-deep">{t.title.mind}</span>
        <span class="muscle block text-[clamp(2.8rem,6.6vw,6.2rem)]">{t.title.muscle}</span>
      </h2>
    </div>

    <!-- Google badge -->
    <div class="flex items-center gap-4 rounded-full bg-bone-dim py-2.5 pr-6 pl-2.5 shadow-[inset_0_0_0_1px_var(--hairline)]">
      <span class="grid size-11 place-items-center rounded-full bg-ink text-bone">
        <span class="muscle text-[1.15rem]">G</span>
      </span>
      <span>
        <span class="flex items-center gap-1.5">
          <span class="muscle text-[1.5rem] leading-none">{'5.0'}</span>
          <span class="flex text-orange" role="img" aria-label={t.ratingLabel}>
            {Array.from({ length: 5 }).map(() => (
              <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true"><path d={star} fill="currentColor" /></svg>
            ))}
          </span>
        </span>
        <span class="micro mt-1 block text-[0.6rem] text-ink/65">Google rating</span>
      </span>
      {!t.reviewsUrl && <span class="micro hidden text-[0.58rem] text-ink/70 sm:inline">TODO: link</span>}
    </div>
  </div>

  <div
    class="track flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-6 md:px-10"
    role="region"
    aria-roledescription="carousel"
    aria-label="Client reviews"
    tabindex="0"
  >
    {testimonials.map((r, i) => (
      <div
        class="card relative flex shrink-0 snap-start flex-col rounded-[1.5rem] p-7 md:p-10"
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} of ${testimonials.length}`}
      >
        {r.placeholder && <span class="micro absolute top-6 right-6 rounded-full bg-ink px-3 py-1.5 text-[0.58rem] text-bone">Placeholder</span>}
        <figure class="m-0 flex flex-1 flex-col justify-between">
          <svg viewBox="0 0 48 36" class="h-8 w-auto self-start text-sage-deep" aria-hidden="true">
            <path d="M2 34V20C2 9 8 3 18 2v6c-5 1-8 5-8 11h8v15H2Zm26 0V20c0-11 6-17 16-18v6c-5 1-8 5-8 11h8v15H28Z" fill="none" stroke="currentColor" stroke-width="1.4" />
          </svg>
          <blockquote class="mt-8 mb-10">
            <p class:list={['quote', { 'quote-long': r.quote.length > 160 }]}>{r.quote}</p>
          </blockquote>
          <figcaption class="flex items-center justify-between gap-4 border-t border-[var(--hairline)] pt-5">
            <span class="font-semibold">{r.name}</span>
            <span class="micro text-[0.6rem] text-ink/70">{r.source} review</span>
          </figcaption>
        </figure>
      </div>
    ))}
  </div>

  <div class="mx-auto mt-6 flex max-w-[1500px] items-center gap-3 px-5 md:px-10">
    <button type="button" class="ctrl prev" aria-label={t.prev} data-dir="-1">
      <Icon name="arrow" size={18} class="rotate-180" />
    </button>
    <button type="button" class="ctrl next" aria-label={t.next} data-dir="1">
      <Icon name="arrow" size={18} />
    </button>
    <button type="button" class="ctrl toggle" aria-label={t.pause} aria-pressed="false">
      <Icon name="pause" size={16} class="i-pause" />
      <Icon name="play" size={16} class="i-play hidden" />
    </button>
    <span class="ml-4 h-px flex-1 bg-[var(--hairline)]" aria-hidden="true"></span>
    <span class="progress micro text-[0.62rem] text-ink/70 tabular-nums" aria-hidden="true">01 / {String(testimonials.length).padStart(2, '0')}</span>
  </div>
</section>

<style>
  .track {
    scrollbar-width: none;
    scroll-padding-inline: 1.25rem;
  }
  .track::-webkit-scrollbar { display: none; }
  @media (min-width: 768px) { .track { scroll-padding-inline: 2.5rem; } }
  .reviews.is-drifting .track { scroll-snap-type: none; }
  .card {
    width: min(86vw, 34rem);
    min-height: 22rem;
    background: var(--color-bone-dim);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .card:nth-child(3n + 2) { background: color-mix(in oklab, var(--color-sage) 32%, var(--color-bone)); }
  .quote {
    font-family: var(--font-mind);
    font-weight: 300;
    font-variation-settings: 'opsz' 72;
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    line-height: 1.18;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .quote-long {
    font-size: clamp(1.2rem, 1.6vw, 1.45rem);
    line-height: 1.3;
  }
  .ctrl {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-ink) 30%, transparent);
    transition: box-shadow 0.8s var(--ease-breath), background-color 0.8s var(--ease-breath);
  }
  .ctrl:hover { box-shadow: inset 0 0 0 1px var(--color-ink); background: var(--color-bone-dim); }
  .reviews.is-paused .toggle :global(.i-pause) { display: none; }
  .reviews.is-paused .toggle :global(.i-play) { display: block; }
  @media (prefers-reduced-motion: reduce) {
    .toggle { display: none; }
  }
</style>
