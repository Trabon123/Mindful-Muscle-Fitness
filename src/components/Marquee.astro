---
/**
 * "Between classes" strip. Pure CSS loop; the moving track is aria-hidden and
 * a static, readable version is provided for assistive tech.
 * Pausable (WCAG 2.2.2), pauses on hover/focus, static under reduced motion.
 */
import Icon from './Icon.astro';
import { marquee } from '../data/site';

const { items } = marquee;
// Repeat enough times that one half always overflows the widest screens.
const run = [...items, ...items];
---

<section class="marquee on-ink relative flex items-center overflow-hidden bg-ink text-bone" aria-label={marquee.label}>
  <p class="sr-only">{items.join('. ')}.</p>

  <div class="track-mask min-w-0 flex-1" aria-hidden="true">
    <div class="track allow-motion">
      {[0, 1].map(() => (
        <ul class="track-half">
          {run.map((item) => (
            <li class="flex items-center">
              <span class="muscle item">{item}</span>
              <span class="sep" />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <button
    type="button"
    class="marquee-toggle mx-3 grid size-10 shrink-0 place-items-center rounded-full text-bone/75 shadow-[inset_0_0_0_1px_var(--hairline-light)] transition-colors hover:text-bone md:mx-6"
    aria-pressed="false"
    aria-label={marquee.pauseLabel}
  >
    <Icon name="pause" size={16} class="i-pause" />
    <Icon name="play" size={16} class="i-play hidden" />
  </button>
</section>

<style>
  .marquee {
    padding-block: clamp(1.1rem, 2.6vw, 2.25rem);
    border-block: 1px solid var(--hairline-light);
  }
  .track-mask {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    /* --dur is set from the measured width so every screen scrolls at the
       same calm reading speed (see script); 60s is the no-JS fallback. */
    animation: marquee var(--dur, 60s) linear infinite;
  }
  .track-half {
    display: flex;
    flex-shrink: 0;
  }
  .item {
    font-size: clamp(2.4rem, 7.2vw, 7.5rem);
    line-height: 1;
    letter-spacing: 0.005em;
    white-space: nowrap;
    padding-top: 0.04em;
  }
  .sep {
    display: inline-block;
    width: 0.32em;
    height: 0.32em;
    margin-inline: 0.55em;
    border-radius: 50%;
    font-size: clamp(2.4rem, 7.2vw, 7.5rem);
    background: var(--color-sage);
  }
  /* Hover-pause only where there's a real mouse; on touch screens a tap
     would otherwise leave it stuck. The pause button works everywhere. */
  @media (hover: hover) and (pointer: fine) {
    .track-mask:hover .track { animation-play-state: paused; }
  }
  .marquee.is-paused .track {
    animation-play-state: paused;
  }
  .marquee.is-paused .marquee-toggle :global(.i-pause) { display: none; }
  .marquee.is-paused .marquee-toggle :global(.i-play) { display: block; }

  @keyframes marquee {
    to { transform: translateX(-50%); }
  }


</style>

<script>
  // Reading speed in px/second. Slower with reduced motion turned on, but it
  // still moves so every word can be read (the pause button stops it).
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SPEED = reduce ? 22 : 40;

  document.querySelectorAll<HTMLElement>('.marquee').forEach((el) => {
    const half = el.querySelector<HTMLElement>('.track-half');
    const track = el.querySelector<HTMLElement>('.track');
    const setSpeed = () => {
      if (half && track) track.style.setProperty('--dur', `${(half.offsetWidth / SPEED).toFixed(1)}s`);
    };
    setSpeed();
    window.addEventListener('resize', setSpeed, { passive: true });
    document.fonts?.ready.then(setSpeed);

    const btn = el.querySelector<HTMLButtonElement>('.marquee-toggle');
    btn?.addEventListener('click', () => {
      const paused = el.classList.toggle('is-paused');
      btn.setAttribute('aria-pressed', String(paused));
    });
  });
</script>
