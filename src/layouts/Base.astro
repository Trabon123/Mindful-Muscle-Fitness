---
import '../styles/global.css';
import antonDataUri from '@fontsource/anton/files/anton-latin-400-normal.woff2?inline';
import { business, seo } from '../data/site';

// Inline the hero's display face (18 KB) so MUSCLE paints in its final font
// on the first frame: no swap, no second LCP candidate.
const antonFace = `@font-face{font-family:"Anton";src:url(${antonDataUri}) format("woff2");font-weight:400;font-style:normal;font-display:block}`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? business.url).href;
const ogImage = new URL(seo.ogImage, Astro.site ?? business.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['HealthClub', 'ExerciseGym'],
  '@id': `${business.url}/#studio`,
  name: business.name,
  legalName: business.legalName,
  description: seo.description,
  slogan: business.positioning,
  url: business.url,
  image: ogImage,
  telephone: business.phone.e164,
  foundingDate: String(business.founded),
  founder: { '@type': 'Person', name: business.owner },
  priceRange: '$', // "Affordable" per owner. TODO: replace with real pricing tier once supplied.
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  openingHours: business.hours.schema,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: business.hours.open,
      closes: '23:59',
    },
  ],
  areaServed: 'Boulder, CO',
  ...(business.instagram ? { sameAs: [`https://www.instagram.com/${business.instagram}/`] } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F4F1EA" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <style set:html={antonFace}></style>
    <link rel="preload" href="/fonts/fraunces-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-bone"
      >Skip to content</a
    >
    <slot />
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
